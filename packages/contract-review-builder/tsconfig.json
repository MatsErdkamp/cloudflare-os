{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "baseUrl": "."
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "__tests__"]
}
