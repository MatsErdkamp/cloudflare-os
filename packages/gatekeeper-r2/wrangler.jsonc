{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-r2",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm run build:configurator && pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }
  ],
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "gadgets-r2-storage" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["R2AccountState", "R2Gatekeeper"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
